# Postgres connection string (Neon, Vercel Postgres, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Long random string. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# The canonical URL of the deployment. Use http://localhost:3000 in dev.
NEXTAUTH_URL="http://localhost:3000"

# Email of the user that should be granted admin on signup. Optional.
ADMIN_EMAIL=""
